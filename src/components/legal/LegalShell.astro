---
// The shared frame for the two plain-words pages (Privacy and Terms): the header, a title, the date of the last change, and a narrow column
// of readable text. The pages put their sections inside it. The colours come from the site's colour variables, so the colour wheel works here too.
import SiteHeader from '@/components/SiteHeader.astro';
import { ThemeDock } from '@/components/ThemeDock';
import { SITE } from '@/config/site';
import Layout from '@/layouts/main.astro';

interface Props {
	title: string;
	description: string;
	updated: string; // e.g. "11 November 2026"
}
const { title, description, updated } = Astro.props;
---

<Layout title={`${title} | ${SITE.name}`} description={description}>
	<SiteHeader>
		<a href="/" class="text-sm text-ink-secondary transition-colors hover:text-ink-primary">Home</a>
	</SiteHeader>
	<main class="mx-auto max-w-2xl px-6 pt-6 pb-24 sm:pt-10">
		<h1 class="text-[clamp(2rem,5vw,3rem)] leading-[1.1] font-bold tracking-tight">{title}</h1>
		<p class="mt-3 text-sm text-ink-muted">Last changed {updated}.</p>
		<!-- The sections are written as plain h2 + p + ul, and styled here once. -->
		<div
			class="mt-8 space-y-4 leading-relaxed text-ink-secondary [&_a]:text-ink-primary [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-ink-primary [&_li]:ml-5 [&_li]:list-disc [&_li]:pl-1 [&_strong]:font-semibold [&_strong]:text-ink-primary [&_ul]:space-y-2"
		>
			<slot />
		</div>
	</main>
	<ThemeDock client:idle />
</Layout>
