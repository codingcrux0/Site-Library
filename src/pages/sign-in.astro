---
// Sign-in page, adapted from a supplied login-form component, now with two buttons only: Google and GitHub (docs/AUTH-PLAN.md).
// The buttons really sign people in while ACCOUNTS_OPEN (src/config/supabase.ts) is true; if it is ever set to false, a click only shows a
// message and nothing is sent. The behaviour is in src/scripts/auth-form.ts.
import AuthShowcase from '@/components/auth/AuthShowcase.astro';
import { SITE } from '@/config/site';
import { ACCOUNTS_OPEN } from '@/config/supabase';
import Layout from '@/layouts/main.astro';

// Logos from Simple Icons 16.36.0 (CC0), inlined so nothing loads from outside.
// When real sign-in is added, check Google's and GitHub's branding rules for sign-in buttons.
const PROVIDERS = [
	{
		name: 'Google',
		path: 'M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z',
	},
	{
		name: 'GitHub',
		path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
	},
];

const OPEN = ACCOUNTS_OPEN;
const TITLE = 'Sign in';
const SUB = OPEN ? 'Continue with Google or GitHub.' : 'Accounts are not open yet.';
const NOTICE = 'Nothing was sent or saved. Accounts open after our privacy checks are done.';
---

<Layout title={`Sign in | ${SITE.name}`} description={OPEN ? 'Sign in with Google or GitHub to save websites and rate them.' : 'Sign in with Google or GitHub. Accounts are not open yet.'}>
	<!-- rv-load: the entrance animation (src/styles/reveal.css) plays once on arrival. overflow-hidden hides the sideways slide. -->
	<main class="rv-load grid min-h-dvh overflow-hidden md:grid-cols-2">
		<AuthShowcase />

		<div class="flex flex-col px-6 py-6">
			<a href="/" class="self-start text-sm text-ink-secondary transition-colors hover:text-ink-primary">&larr; Home</a>

			<!-- Top-aligned, not centred, like before. -->
			<div class="rv-slide flex flex-1 items-start justify-center pt-[clamp(1rem,8vh,5rem)] pb-10" data-from="right">
				<div data-auth data-open={OPEN ? '1' : '0'} class="flex w-full max-w-sm flex-col items-center">
					<h1 class="rv-block rv-delay-1 text-4xl font-semibold tracking-tight">
						<span class="rv-text">{TITLE}</span>
					</h1>
					<p class="rv-block rv-delay-2 mt-3 text-center text-sm text-ink-secondary">
						<span class="rv-text">{SUB}</span>
					</p>

					<div class="rv-fade rv-fade-1 mt-8 grid w-full grid-cols-2 gap-3">
						{
							PROVIDERS.map((provider) => (
								<button
									type="button"
									data-provider={provider.name}
									aria-label={`Continue with ${provider.name}`}
									class="flex h-12 items-center justify-center gap-2 rounded-full border border-line-strong bg-surface-raised text-sm font-medium text-ink-primary transition-[background-color,transform] duration-150 hover:bg-surface-sunken active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus motion-reduce:transition-none motion-reduce:active:scale-100"
								>
									<svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
										<path d={provider.path} />
									</svg>
									{provider.name}
								</button>
							))
						}
					</div>

					<p class="rv-fade rv-fade-1 mt-6 text-center text-xs leading-relaxed text-ink-muted">
						By continuing you accept the <a href="/terms/" class="underline underline-offset-4 hover:text-ink-primary">Terms</a> and the
						<a href="/privacy/" class="underline underline-offset-4 hover:text-ink-primary">Privacy page</a>.
					</p>

					<!-- Filled in by the script, then cleared after a few seconds. Pinned to the bottom of the screen so it is always in view. -->
					<p
						id="auth-notice"
						role="status"
						data-notice={NOTICE}
						class="rv-swap fixed inset-x-4 bottom-4 z-50 mx-auto max-w-sm rounded-2xl border border-line-subtle bg-tint-sand px-4 py-3 text-center text-sm text-ink-primary shadow-lg empty:hidden"
					></p>
				</div>
			</div>
		</div>
	</main>
	<script>
		import '@/scripts/auth-form';
	</script>
</Layout>
