---
// The owner's page for approving written reviews. It is NOT linked from anywhere, NOT in the sitemap and tells search engines to stay out; but
// hiding a page is not what keeps it safe. What keeps it safe is the database: every call this page makes is refused unless the signed-in
// account is the owner (supabase/moderation.sql). A visitor who finds the address sees one sentence and nothing else.
import SiteHeader from '@/components/SiteHeader.astro';
import { ThemeDock } from '@/components/ThemeDock';
import AdminReviews from '@/components/admin/AdminReviews';
import { ENTRIES } from '@/config/library';
import { SITE } from '@/config/site';
import Layout from '@/layouts/main.astro';

// Website id -> name, so each review says which website it is about.
const names = Object.fromEntries(ENTRIES.map((entry) => [entry.id, entry.name]));
---

<Layout title={`Reviews | ${SITE.name}`} description="Approve written reviews.">
	<meta slot="head" name="robots" content="noindex, nofollow" />
	<SiteHeader>
		<a href="/websites/" class="text-sm text-ink-secondary transition-colors hover:text-ink-primary">The list</a>
	</SiteHeader>
	<main class="mx-auto max-w-3xl px-6 pt-6 pb-24 sm:pt-10">
		<h1 class="text-[clamp(2rem,5vw,3rem)] leading-[1.1] font-bold tracking-tight">Reviews</h1>
		<p class="mt-3 mb-8 text-sm text-ink-muted">Approve a review so everyone can read it, or hide or delete it.</p>
		<AdminReviews client:load names={names} />
	</main>
	<ThemeDock client:idle />
</Layout>
